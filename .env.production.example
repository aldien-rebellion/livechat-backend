# ==========================================
# Production Environment Configuration
# Copy this file to /opt/livechat-server/.env
# ==========================================

# Docker Hub Username (used by Docker Compose image tags)
DOCKERHUB_USERNAME=aldien

# Domain / FQDN (pointing to EC2 Public IPv4)
DOMAIN_NAME=livechat.example.com
CERTBOT_EMAIL=admin@example.com

# PostgreSQL Database Configuration
POSTGRES_USER=livechat_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD
POSTGRES_DB=livechat_db
POSTGRES_PORT=5432

# Redis Cache & Broker Configuration
REDIS_PORT=6379

# Backend FastAPI Configuration
API_PORT=8000
SECRET_KEY=GENERATE_A_RANDOM_LONG_SECRET_KEY_FOR_JWT_HERE

# Reverse Proxy / SSL Ports
NGINX_PORT=80
NGINX_SSL_PORT=443

# Observability Configuration
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
